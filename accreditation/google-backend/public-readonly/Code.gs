من الاطلاع على طبيعة، ومتطلبات البرامج التعليمية."},{"code":"4.3","text":"للمؤسسة آلية لتزويد الطلاب بنشرة تعريفية عن البرامج التعليمية، تتضمن معلومات كافية حول خدمات الدعم الطلابي، والرعاية المتوفرة لهم."},{"code":"4.4","text":"للمؤسسة آلية تعتمد على أعضاء هيئة التدريس، والخبراء الذين ترى الاستعانة بهم في تصميم برامجها التعليمية وتطويرها."},{"code":"4.5","text":"للمؤسسة آلية لتقييم برامجها التعليمية بشكل دوري، وتوظيف نتائج التقييم في عمليات التطوير والتحسين."},{"code":"4.6","text":"للمؤسسة آلية تُلزم إدارات البرامج التعليمية بضرورة وجود ملف أكاديمي لكل مقرر دراسي، ومتابعة ما يحدث فيه من تطوير وتحسين."},{"code":"4.7","text":"للمؤسسة آلية واضحة تضمن تنوّع مصادر التعليم والتعلّم، بما يلبي احتياجات المجتمع وسوق العمل."},{"code":"4.8","text":"للمؤسسة آلية تُمكِّن الطلاب من الانتقال من وإلى البرامج التعليمية المختلفة داخلها وخارجها."},{"code":"4.9","text":"للمؤسسة آلية لمراجعة سياسة القبول بالبرامج التعليمية بشكل دوري، مع المعنيين وأصحاب المصلحة، بما في ذلك أرباب العمل."},{"code":"4.10","text":"للمؤسسة آلية تُلزم إدارات البرامج باتباع نظام الإشراف الأكاديمي، والريادة العلمية، بما يتناسب مع طبيعة كل برنامج."},{"code":"4.11","text":"المؤسسة تستند إلى معايير أكاديمية، أو مقارنة مرجعية (معايير قياسية) في وصف وتوصيف برامجها التعليمية، ومقرراتها الدراسية."},{"code":"4.12","text":"للمؤسسة آلية للتعامل مع الطلاب المتعثّرين، والمتفوّقين، وذوي الاحتياجات الخاصة في البرامج التعليمية."},{"code":"4.13","text":"لمؤسسة آلية تُلزم من خلالها إدارات البرامج بتوازن مقرراتها الدراسية في خططها الدراسية."},{"code":"4.14","text":"للمؤسسة آلية للاستفادة من نتائج تقييم برامجها التعليمية."},{"code":"4.15","text":"للمؤسسة آلية لمعرفة مدى ملاءمة برامجها لمتطلبات سوق العمل."},{"code":"4.16","text":"للمؤسسة آلية لتقييم وتقويم مخرجات التعلّم المستهدفة لكل البرامج التعليمية."},{"code":"4.17","text":"للمؤسسة آلية تُلزم إدارات البرامج التعليمية بوضع مواصفات للخريج."},{"code":"4.18","text":"للمؤسسة آلية لتنظيم وتنسيق التدريب الميداني في البرامج التعليمية."},{"code":"4.19","text":"للمؤسسة آلية تُلزم أعضاء هيئة التدريس بتقديم تقرير عن المقرر الدراسي."},{"code":"4.20","text":"للمؤسسة آلية للاستفادة من تقارير المقررات الدراسية."},{"code":"4.21","text":"الأنشطة العلمية، والاجتماعية، والرياضية التي تنظّمها المؤسسة، يشرف عليها مسؤولون يتمتعون بالكفاية."}]},{"number":5,"title":"الشؤون الطلابية","indicators":[{"code":"5.1","text":"للمؤسسة آلية لقبول الطلاب تنسجم مع رسالتها، وأهدافها، وخططها، (واضحة، ومعلنة، ومنشورة)."},{"code":"5.2","text":"للمؤسسة آلية لتنسيب الطلاب المقبولين في التخصصات المختلفة، مناسبة لقدرتها الاستيعابية، وملتزمة بها."},{"code":"5.3","text":"للمؤسسة لائحة داخلية خاصة بالدراسة والامتحانات والتأديب، وملتزمة بتطبيقها."},{"code":"5.4","text":"للمؤسسة عناصر بشرية مؤهلة لمساعدة الطلاب على إتمام إجراءاتهم."},{"code":"5.5","text":"للمؤسسة آلية لتوفير الدعم المناسب للطلاب ذوي الإعاقة."},{"code":"5.6","text":"للمؤسسة آلية لتوثيق معاملات الطلاب المتفوقين، والمتعثرين."},{"code":"5.7","text":"تحتفظ المؤسسة بملف إداري، وآخر أكاديمي للطالب، يبيِّن نتائج تحصيله المعرفي."},{"code":"5.8","text":"تحتفظ المؤسسة بالسجلات الأصلية للطلاب."},{"code":"5.9","text":"للمؤسسة آلية تبيِّن أماكن حفظ النسخ الاحتياطية لسجلات الطلاب، وتكفل سرية المعلومات."},{"code":"5.10","text":"للمؤسسة آلية تُنظِّم عملية اطلاع الطلاب على سجلاتهم."},{"code":"5.11","text":"للمؤسسة آلية لاختيار، وتسمية المرشد الأكاديمي، أو الرائد العلمي."},{"code":"5.12","text":"للمؤسسة آلية تمكِّن الطلاب من التواصل مع أعضاء هيئة التدريس، والكوادر المساندة."},{"code":"5.13","text":"للمؤسسة آلية واضحة للطعن، والتظلُّم، والشكاوى، وكيفية التعامل معها."},{"code":"5.14","text":"للمؤسسة آلية للاستفادة من معالجة الطعون، وشكاوى الطلاب."},{"code":"5.15","text":"تلتزم المؤسسة بتقديم الدعم اللازم للأنشطة الطلابية، وتحدِّد مخصصات لها من الميزانية."},{"code":"5.16","text":"للمؤسسة آلية تمكِّن الطلاب من انتخاب اتحاد الطلاب."},{"code":"5.17","text":"توفِّر المؤسسة الخدمات الصحية الأساسية للطلاب."},{"code":"5.18","text":"للمؤسسة أنظمة، وطرق فعّالة؛ للتواصل مع الطلاب خارج أوقات الدوام الرسمي."},{"code":"5.19","text":"للمؤسسة آلية لاستطلاع آراء الطلاب في جوانب محددة من العملية التعليمية."},{"code":"5.20","text":"للمؤسسة آلية للاستفادة من استطلاع آراء الطلاب."},{"code":"5.21","text":"للمؤسسة آلية تمكِّن الطلاب من المشاركة في صناعة القرارات، وحلِّ المشكلات التي تتعلَّق مباشرة بحقوقهم، وواجباتهم."},{"code":"5.22","text":"للمؤسسة آلية لمعرفة مدى ملاءمة برامجها لمتطلبات سوق العمل من وجهة نظر خريجيها."},{"code":"5.23","text":"للمؤسسة وحدة لمتابعة الخريجين، وآلية لمتابعتهم، والاستفادة من آرائهم."},{"code":"5.24","text":"تلتزم المؤسسة بتسليم قوائم الخريجين للمركز، ونشرها على موقعها الإلكتروني دوريّاً، وسنويّاً"}]},{"number":6,"title":"المرافق وخدمات الدعم التعليمية","indicators":[{"code":"6.1","text":"للمؤسسة مساحات، ومبانٍ تفي بتحقيق أهدافها التعليمية، والتدريبية، والبحثية."},{"code":"6.2","text":"للمؤسسة ما يثبت ملكيتها لأصولها الثابتة، والمنقولة، أو امتلاكها الحقّ القانوني في استخدام المباني، والمرافق لتقديم خدماتها."},{"code":"6.3","text":"للمؤسسة قاعات، ومعامل، وورش، ومختبرات تفي بمتطلبات تنفيذ العملية التعليمية."},{"code":"6.4","text":"للمؤسسة خطط مفعّلة لصيانة المباني، والمعامل، والورش، والمختبرات، ومرافقها كافة."},{"code":"6.5","text":"للمؤسسة آلية تضمن الالتزام المستمر بمتطلبات المباني والمرافق الصادرة عن المركز."},{"code":"6.6","text":"للمؤسسة قواعد للأمن والسلامة في المعامل، والورش، والمختبرات."},{"code":"6.7","text":"المؤسسة توفّر الإرشادات العامة حول الأمن والسلامة للطلبة، والعاملين، والزوار."},{"code":"6.8","text":"للمؤسسة مخازن تتوافر فيها الخصائص، والشروط المطلوبة، تفي بمتطلبات العملية التعليمية."},{"code":"6.9","text":"للمؤسسة آلية لمراقبة ومتابعة المقاهي، والمطاعم، والعاملين بها، وفقاً للشروط الصحية."},{"code":"6.10","text":"للمؤسسة آلية لمتابعة مكاتب الخدمات في الحرم الجامعي، كخدمات التصوير، والقرطاسية، ولوازم الحاسوب، وخدمات الإنترنت، وغيرها من الخدمات… إلخ."},{"code":"6.11","text":"للمؤسسة قاعات دراسية تتوفر فيها الشروط الصحية من تكييف، وتدفئة، وتهوية، وإنارة."},{"code":"6.12","text":"المؤسسة تيسّر لمنتسبيها، بمن فيهم ذوو الإعاقة، إمكان الوصول، واستعمال أماكن الدراسة، والمكتبة، والمعامل، والورش، وكل مرافق المؤسسة."},{"code":"6.13","text":"المؤسسة تعمل على توفير المساحة الشخصية الكافية لأعضاء هيئة التدريس من أجل تحضير الدروس، والعمل مع الطلبة."},{"code":"6.14","text":"المؤسسة توفّر المساحات الشخصية الكافية، والأماكن اللازمة للكوادر المساندة."},{"code":"6.15","text":"المؤسسة تعمل على توفير أماكن للطلبة، وأعضاء هيئة التدريس، والعاملين؛ لتأمين ممتلكاتهم الشخصية، بما فيها مواقف للسيارات."},{"code":"6.16","text":"المؤسسة توفّر مساحات وأماكن كافية لراحة منتسبيها، من مرافق خدمية، وأماكن للصلاة."},{"code":"6.17","text":"المؤسسة توفّر العدد الكافي من دورات المياه، والمشارب الصالحة للاستعمال بشكل مستمر."},{"code":"6.18","text":"المؤسسة توفّر المرافق الخاصة بالأنشطة الترفيهية، والرياضية، والأعمال الإبداعية."},{"code":"6.19","text":"الموقع الإلكتروني، والمواد المطبوعة للمؤسسة توفّر وصفاً دقيقاً لموقعها، ومرافقها، ومبانيها، والتسهيلات المتوفرة، وطبيعة مواردها، والخدمات التي تقدّمها."},{"code":"6.20","text":"للمؤسسة آلية فعّالة لتحديث المعلومات على الموقع الإلكتروني بشكل دوري ومنتظم."},{"code":"6.21","text":"السكن الجامعي الطلابي نظيف، وآمن، وذو مستوى كافٍ لتلبية احتياجات الطلبة."},{"code":"6.22","text":"للمؤسسة آلية واضحة للعناية بالسكن الجامعي من نظافة، وصيانة لمرافقه المختلفة."},{"code":"6.23","text":"للمؤسسة مكتبة تُدار بكوادر كافية، يتمتعون بالمعرفة، والخبرة المناسبة."},{"code":"6.24","text":"للمؤسسة آلية لفهرسة، وتبويب المصادر، والمراجع التعليمية المناسبة لبرامجها (ورقية وإلكترونية)."},{"code":"6.25","text":"للمؤسسة آلية لتطوير، وتحسين خدمات المكتبة كنظام الإعارة، وأوقات العمل المناسبة حسب المتطلبات، وظروف سير العملية التعليمية."},{"code":"6.26","text":"للمؤسسة العدد الكافي من الحواسيب، والبرمجيات الحديثة ذات المواصفات المناسبة لتسيير العملية التعليمية."}]},{"number":7,"title":"البحث العلمي","indicators":[{"code":"7.1","text":"للمؤسسة مكتب خاص يتولى ادارة العمليات، والاجراءات المتعلقة بالبحث العلمي."},{"code":"7.2","text":"للمؤسسة الية تحدد الاولويات، وجميع التسهيلات لدعم البحث العلمي، واعمال التأليف، والترجمة."},{"code":"7.3","text":"للمؤسسة ميثاق اخلاق، يتضمن التقيد باداب، واخلاقيات البحث العلمي."},{"code":"7.4","text":"للمؤسسة الية تحفز الباحثين من منسوبيها لاجراء البحوث العلمية في مجال تخصصهم، ونشر نتائجها بالدوريات العلمية محليا، واقليميا، ودوليا."},{"code":"7.5","text":"للمؤسسة الية تعكس مدى الاتساق بين البحث العلمي، والعملية التعليمية."},{"code":"7.6","text":"خطط البحث العلمي في المؤسسة تتوافق مع الاولويات التي تعتمدها المؤسسة، والاولويات الوطنية في الدولة."},{"code":"7.7","text":"للمؤسسة ضوابط لتقييم اداء، وانتاج اعضاء هيئة التدريس البحثي، بما يحقق تطلعات وتوقعات المؤسسة في مجال البحث العلمي."},{"code":"7.8","text":"الخطة الاستراتيجية للمؤسسة تظهر التزامها بتشجيع ريادة الاعمال."},{"code":"7.9","text":"للمؤسسة آليةٌ منتظمة للتواصل مع أرباب العمل، والقطاعات، والمؤسسات ذات العلاقة؛ للحصول على التغذية الراجعة؛ لتطوير مناهجها، وتعزيز البحوث العلمية المشتركة."},{"code":"7.10","text":"للمؤسسة الية واضحة لعقد الاتفاقيات العلمية، والبحثية، وتبادل الزيارات مع مؤسسات مماثلة محليا، واقليميا، ودوليا."},{"code":"7.11","text":"للمؤسسة الية لتقييم، وتطوير سياسة البحث العلمي."},{"code":"7.12","text":"للمؤسسة الية تحدد نسبة، وكيفية الانفاق على الابحاث من موازنتها."},{"code":"7.13","text":"للمؤسسة الية للاستفادة من التقييم، والتغذية الراجعة في تطوير سياسة البحث العلمي."},{"code":"7.14","text":"للمؤسسة الية لتوثيق المرات التي استشهد بها في الابحاث العلمية، التي انتجها منسوبوها. يتضمن نسبة الاستشهادات الى عدد الباحثين."},{"code":"7.15","text":"للمؤسسة الية لدعم المشاركة في المحافل، والمؤتمرات العلمية."},{"code":"7.16","text":"للمؤسسة الية للاهتمام ببحوث الطلاب، وكيفية الاستفادة من البحوث المتميزة، وتوظيفها للاستفادة، ونشرها."},{"code":"7.17","text":"للمؤسسة مجلة علمية دورية محكمة، ومسجلة في قواعد البيانات."},{"code":"7.18","text":"للمؤسسة الية لتحكيم البحوث العلمية."},{"code":"7.19","text":"للمؤسسة اشتراكات بمكتبات علمية محلية، واقليمية، ودولية، تمكن الباحثين من الاطلاع على مستجدات البحث العلمي."},{"code":"7.20","text":"للمؤسسة الية لتنمية مهارات الطلاب البحثية."}]},{"number":8,"title":"خدمة المجتمع والبيئة","indicators":[{"code":"8.1","text":"للمؤسسة مكتبٌ خاصٌّ يتولّى تنسيق برامجها لخدمة المجتمع، والبيئة."},{"code":"8.2","text":"للمؤسسة خطةٌ لخدمة المجتمع المحلي، والبيئة المحيطة."},{"code":"8.3","text":"للمؤسسة آليّةٌ للتعرّف على مشكلات المجتمع المحلي، والبيئة المحيطة."},{"code":"8.4","text":"للمؤسسة آليّةٌ لنشر وتعزيز القيم الأخلاقية، والإنسانية، والوطنية، والدينية."},{"code":"8.5","text":"تعدّ المؤسسة تقريرًا سنويًا يتضمّن تفاصيل الخدمات المجتمعية، وأشكال المشاركة فيها."},{"code":"8.6","text":"تحدِّد المؤسسة المخصّصات المالية من ميزانيتها لخدمة المجتمع المحلي، والبيئة."},{"code":"8.7","text":"للمؤسسة آليّةٌ لاستطلاع رأي المجتمع فيما تقدّمه من خدمات مجتمعية، وبيئية."},{"code":"8.8","text":"للمؤسسة آليّةٌ للاستفادة من نتائج استطلاع الآراء فيما تساهم به من خدمات للمجتمع."},{"code":"8.9","text":"للمؤسسة آليّةٌ للمساهمة في نشر المعرفة، وثقافة الاهتمام بالبيئة داخل المجتمع."},{"code":"8.10","text":"للمؤسسة آليّةٌ لبناء شراكات مع مؤسّسات المجتمع المحلي، ومؤسّسات المجتمع المدني، في مجالات الخدمة الاقتصاديّة، والاجتماعيّة التي يحتاجها المجتمع المحلي."},{"code":"8.11","text":"للمؤسسة آليّةٌ للتعاون مع المنظمات، ومؤسّسات المجتمع المدني، والشبكات، والاتحادات العلميّة التي تسهم في خدمة المجتمع المحلي، والبيئة."},{"code":"8.12","text":"تشجِّع المؤسسة أعضاء هيئة التدريس على المشاركة في الندوات، والمؤتمرات التي تهتم بمشكلات المجتمع المحلي، والبيئة."},{"code":"8.13","text":"تحفّز المؤسسة الطلبة على المشاركة في ممارسة الأنشطة غير الصفّية في مجال خدمة المجتمع، والبيئة."},{"code":"8.14","text":"للمؤسسة آليّةٌ واضحة للتعاون مع النقابات، ومختلف الجهات ذات العلاقة بخدمة المجتمع المحلي، والبيئة."}]},{"number":9,"title":"ضمان الجودة والتحسين المستمر","indicators":[{"code":"9.1","text":"للمؤسسة مكتبٌ خاص يتولى إدارة عمليات ضمان الجودة."},{"code":"9.2","text":"للمؤسسة كوادر بشرية تتمتع بالكفاية، والمعرفة، والخبرة في مجال ضمان الجودة والاعتماد."},{"code":"9.3","text":"للمؤسسة آلية تمكِّن إدارة الجودة من المشاركة في صنع القرار."},{"code":"9.4","text":"المؤسسة تلتزم بتقديم الدعم، وتوفير الإمكانات اللازمة لبرامج، ومشاريع إدارة الجودة."},{"code":"9.5","text":"للمؤسسة آلية لنشر ثقافة الجودة، وتعزيزها."},{"code":"9.6","text":"للمؤسسة آلية مستمرة للتقييم الذاتي، وفق معايير الاعتماد الصادرة عن المركز."},{"code":"9.7","text":"للمؤسسة آلية تدعم التعاون، والتنسيق بين مكاتب ووحدات الجودة بالمؤسسة."},{"code":"9.8","text":"للمؤسسة آلية واضحة لقياس مستوى رضا الطلاب، والعاملين، وأعضاء هيئة التدريس."},{"code":"9.9","text":"للمؤسسة آلية واضحة، ونماذج معتمدة، ومنشورة لعملية تقييم أداء العاملين."},{"code":"9.10","text":"للمؤسسة آلية تدعو من خلالها أصحاب المصلحة لإبداء آرائهم، ومقترحاتهم لغرض التطوير، والتحسين المستمر."},{"code":"9.11","text":"للمؤسسة آلية للاستفادة من نتائج عملية تقييم أداء منتسبيها، وآراء أصحاب المصلحة."},{"code":"9.12","text":"للمؤسسة خطط للتطوير، والتحسين المستمر في ضوء نتائج التقييم الذاتي."},{"code":"9.13","text":"المؤسسة تعمل على تطبيق خططها التنفيذية، ومراجعتها دورياً."},{"code":"9.14","text":"للمؤسسة آلية لتوثيق، وضمان سلامة البيانات التي يتم جمعها من أجل إدخال أي تحسينات ضرورية، وقياس أثرها."},{"code":"9.15","text":"للمؤسسة آلية تُلزم إدارات البرامج باستطلاع آراء الطلاب في جودة العملية التعليمية، وتوظيف نتائجها في التحسين والتطوير."},{"code":"9.16","text":"للمؤسسة آلية تضمن توفر المتطلبات اللوجستية التي تسهم في تنفيذ ورش العمل، والندوات، والمؤتمرات ذات العلاقة بنشر، وترسيخ متطلبات تجويد العملية التعليمية."}]},{"number":10,"title":"التعليم الإلكتروني والتعلم عن بعد","indicators":[{"code":"10.1","text":"للمؤسسة موقع إلكتروني على شبكة المعلومات الدولية (الإنترنت)."},{"code":"10.2","text":"للمؤسسة آلية لدعم عملية إنتاج المقررات التعليمية إلكترونياً."},{"code":"10.3","text":"للمؤسسة وحدة فنية تدعم التعليم الإلكتروني والتعلم عن بعد إنتاجاً وتقديماً."},{"code":"10.4","text":"للمؤسسة أنظمة تلبي متطلبات التعليم الإلكتروني والتعلم عن بعد، وتحدد مهام الطالب وحقوقه."},{"code":"10.5","text":"المؤسسة تستخدم تقنية حديثة ومناسبة لبرامج التعليم الإلكتروني والتعلم عن بعد، بحيث تشمل خدمات الطالب، وإدارة العملية التعليمية، وتسهيلات وسائل الاتصال المتنوعة بين الأستاذ والطالب."},{"code":"10.6","text":"للمؤسسة آلية تؤكد من خلالها التعرف على رضا المستفيدين من طلاب وأساتذة عن التعليم الإلكتروني والتعلم عن بعد."},{"code":"10.7","text":"للمؤسسة آلية للاستفادة من استطلاعات الرأي من قبل الأساتذة والطلبة وأصحاب المصلحة في التعليم الإلكتروني والتعلم عن بعد."},{"code":"10.8","text":"للمؤسسة آلية مرنة في عمليات تطوير وتحسين المحتوى التعليمي للتعليم الإلكتروني والتعلم عن بعد، بما يضمن نتائج التعلم المستهدفة."},{"code":"10.9","text":"للمؤسسة آلية تمكن الطلاب من الوصول إلى المحتوى المناسب في الوقت المناسب وبالتقنية المناسبة."},{"code":"10.10","text":"للمؤسسة آلية لتطوير مخازن المحتوى التعليمي الإلكتروني وإتاحتها لمختلف المستويات."},{"code":"10.11","text":"للمؤسسة آلية واضحة لدعم ومساعدة الطلاب على التعليم الإلكتروني والتعلم عن بعد من حيث المهارات اللازمة وخدمات القبول والدعم المالي بصورة منتظمة."},{"code":"10.12","text":"للمؤسسة آلية لمراعاة حقوق النسخ وحقوق الملكية الفكرية في المواد المنتجة إلكترونياً."}]}];

function doGet(event) {
  const callback = String(event && event.parameter && event.parameter.callback || '');
  if (callback && !/^[A-Za-z_$][\w$]{0,60}$/.test(callback)) return output_({error:'INVALID_CALLBACK'},'');
  try {
    const cache = CacheService.getScriptCache(), key = 'public-projection-v1';
    let payload = cache.get(key);
    if (!payload) {
      payload = JSON.stringify(summary_());
      if (payload.length < 40000) cache.put(key,payload,60);
    }
    return output_(JSON.parse(payload),callback);
  } catch(e) { return output_({error:'SUMMARY_UNAVAILABLE',message:'تعذر قراءة الملخص الحالي؛ حاول لاحقًا.'},callback); }
}
function doPost() { return output_({error:'READ_ONLY'},''); }
function output_(value,callback) {
  const body = JSON.stringify(value).replace(/</g,'\\u003c').replace(/>/g,'\\u003e').replace(/&/g,'\\u0026').replace(/\u2028/g,'\\u2028').replace(/\u2029/g,'\\u2029');
  return ContentService.createTextOutput(callback ? callback+'('+body+');' : body).setMimeType(callback ? ContentService.MimeType.JAVASCRIPT : ContentService.MimeType.JSON);
}
function verifyPublicSetup() {
  const data = summary_();
  const result = {ok:true,criteria:data.criteria.length,indicators:data.criteria.reduce((n,c)=>n+c.total,0),tasks:data.tasks.length,
    sources:data.evidence.length,documented:data.criteria.reduce((n,c)=>n+c.documented,0),accepted:data.criteria.reduce((n,c)=>n+c.accepted,0)};
  console.log(JSON.stringify(result));
  return result;
}
function summary_() {
  const id = PropertiesService.getScriptProperties().getProperty('REGISTRY_SPREADSHEET_ID');
  if (!id || !/^[A-Za-z0-9_-]{20,}$/.test(id)) throw new Error('CONFIG');
  const book = SpreadsheetApp.openById(id);
  const indicators = read_(book,'المؤشرات',['معرف المؤشر','حالة التقييم','الانطباق','حالة الشواهد','مبرر الاستثناء','مرجع اعتماد الاستثناء','المراجع','تاريخ المراجعة']);
  if (indicators.length !== 184) throw new Error('COUNT');
  const evidenceRows = read_(book,'الشواهد',['معرف الشاهد','معرف المؤشر','معرف المهمة','اسم الملف','معرف ملف درايف','حالة النشر','رابط عام'],['نوع المصدر','مرجع المصدر','حالة المصدر','نطاق الربط','وصف الشاهد','حالة المراجعة']);
  const documentedCodes = new Set(evidenceRows.filter(documented_).map(e=>e['معرف المؤشر']));
  const byId = Object.create(null);
  indicators.forEach(row => { const code = row['معرف المؤشر']; if (byId[code]) throw new Error('DUPLICATE'); byId[code] = row; });
  const criteria = CATALOG_.map(c => {
    const items = c.indicators.map(i => {
      const row = byId[i.code]; if (!row) throw new Error('MISSING');
      const status = status_(row), available = documentedCodes.has(i.code);
      return {code:i.code,text:i.text,status:available && status==='unassessed' ? 'documented_pending_review' : status,evidenceAvailable:available,evidenceIds:[]};
    });
    return {number:c.number,title:c.title,total:items.length,accepted:items.filter(i=>i.status==='accepted').length,
      notApplicable:items.filter(i=>i.status==='na').length,documented:items.filter(i=>i.evidenceAvailable).length,availableEvidence:0,
      reviewed:items.filter(i=>i.status==='accepted'||i.status==='returned').length,indicators:items};
  });
  const people = read_(book,'الفريق',['البريد الإلكتروني','الاسم','الدور','الحالة']).filter(p=>p['الحالة']==='نشط');
  const names = Object.create(null);
  people.forEach(p=>names[String(p['البريد الإلكتروني']).trim().toLowerCase()]=publicText_(p['الاسم']));
  const tasks = read_(book,'المهام',['معرف المهمة','عنوان المهمة','الشواهد المطلوبة','الدور المسؤول المقترح','بريد المسؤول','الفترة من المصدر','الموعد المحدد','حالة المهمة','معرفات المؤشرات المعتمدة'],['معرفات المؤشرات المقترحة','الحالة في الخطة','آخر تحديث سردي']).map(t=>{
    const approved=codes_(t['معرفات المؤشرات المعتمدة']), proposed=codes_(t['معرفات المؤشرات المقترحة']);
    const current=t['حالة المهمة'];
    return {id:t['معرف المهمة'],title:publicText_(t['عنوان المهمة']),requirement:approved[0]||proposed[0]||'',
      requiredEvidence:publicText_(t['الشواهد المطلوبة']),unit:publicText_(t['الدور المسؤول المقترح']),
      assigneeName:names[String(t['بريد المسؤول']).trim().toLowerCase()]||'',period:publicText_(t['الفترة من المصدر']),due:t['الموعد المحدد'],
      status:current,sourceStatus:publicText_(current && current!=='بانتظار مراجعة الحالة' ? current : t['الحالة في الخطة']),
      sourceUpdate:publicText_(t['آخر تحديث سردي']),indicatorCodes:approved,proposedIndicatorCodes:proposed,
      mappingStatus:approved.length ? 'ربط داخلي معتمد' : 'ربط مقترح يحتاج مراجعة'};
  });
  const catalog = Object.create(null);
  evidenceRows.filter(e=>['منشور','بيانات وصفية فقط'].includes(e['حالة النشر'])).forEach(e=>{
    const id=e['معرف ملف درايف'], url=e['رابط عام'];
    const driveLink = validDriveId_(id) && new RegExp('^https://drive\\.google\\.com/file/d/'+id+'/view(?:\\?resourcekey=[A-Za-z0-9_-]+)?$').test(url);
    const webLink = ['github','web'].includes(String(e['نوع المصدر']).toLowerCase()) && knownSourceUrl_(url) && e['حالة المصدر']==='متحقق من المحتوى';
    const publicLink = e['حالة النشر']==='منشور' && (driveLink || webLink);
    const key = e['نوع المصدر']+':'+(e['مرجع المصدر'] || id || e['معرف الشاهد']);
    if (!catalog[key]) catalog[key] = {id:e['معرف الشاهد'],name:publicText_(e['اسم الملف']),url:publicLink ? url : '',
      taskId:e['معرف المهمة'],indicatorCode:e['معرف المؤشر'],taskIds:[],indicatorCodes:[],indicatorIds:[],
      sourceStatus:publicText_(e['حالة المصدر'] || 'شاهد مرفوع'),mappingStatus:publicText_(e['نطاق الربط'] || 'مرتبط بالمؤشر'),
      statusLabel:publicText_(e['حالة المراجعة'] || e['حالة المصدر'] || 'شاهد مرفوع بانتظار المراجعة'),
      description:publicText_(e['وصف الشاهد']),
      accessNote:publicLink ? 'رابط عرض عام؛ وجود المصدر لا يعني قبول المؤشر' : validDriveId_(id) ? 'نسخة محفوظة في أرشيف Google Drive؛ العرض العام للملف غير مفعّل' : 'مرجع موثق؛ رابط العرض العام لم يُضف بعد',
      availability:publicLink ? 'public_file' : validDriveId_(id) ? 'archived_reference' : 'catalogued_reference'};
    if (e['معرف المهمة'] && !catalog[key].taskIds.includes(e['معرف المهمة'])) catalog[key].taskIds.push(e['معرف المهمة']);
    if (e['معرف المؤشر'] && !catalog[key].indicatorCodes.includes(e['معرف المؤشر'])) catalog[key].indicatorCodes.push(e['معرف المؤشر']);
  });
  const evidence = Object.keys(catalog).map(k=>{catalog[k].indicatorIds=catalog[k].indicatorCodes.slice();return catalog[k];});
  criteria.forEach(c=>{
    c.indicators.forEach(i=>i.evidenceIds=evidence.filter(e=>e.indicatorIds.includes(i.code)).map(e=>e.id));
    c.availableEvidence=evidence.filter(e=>e.indicatorIds.some(code=>String(code).split('.')[0]===String(c.number))).length;
  });
  const team = people.filter(p=>['مدير النظام','مراجع','عضو فريق'].includes(p['الدور'])).map(p=>({name:publicText_(p['الاسم']),role:p['الدور'],roleLabel:p['الدور']}));
  // Only the listed public fields are returned. Source reference IDs, emails, audit and private links stay server-side.
  return {schemaVersion:1,updatedAt:new Date().toISOString(),mode:'live',source:'سجل المتابعة الداخلي لكلية التمريض',criteria:criteria,tasks:tasks,evidence:evidence,team:team};
}
function validDriveId_(id) { return /^[A-Za-z0-9_-]{10,}$/.test(String(id||'')) && !/^(?:libfile_|file_000000)/.test(String(id)); }
function knownSourceUrl_(url) {
  return /^https:\/\/(?:github\.com|raw\.githubusercontent\.com|[a-z0-9-]+\.github\.io|(?:[a-z0-9-]+\.)?(?:tu\.edu\.ly|qaa\.ly))\//i.test(String(url||''));
}
function documented_(e) {
  if (!/^\d{1,2}\.\d{1,2}$/.test(String(e['معرف المؤشر']||''))) return false;
  if (validDriveId_(e['معرف ملف درايف'])) return true;
  if (e['حالة المصدر']!=='متحقق من المحتوى') return false;
  const type=String(e['نوع المصدر']||'').toLowerCase(), ref=String(e['مرجع المصدر']||'');
  if (type==='library') return /^libfile_[A-Za-z0-9_-]+$/.test(ref);
  if (type==='drive') return validDriveId_(ref) || /^https:\/\/(?:drive|docs)\.google\.com\//.test(ref);
  return ['github','web'].includes(type) && knownSourceUrl_(ref);
}
function codes_(value) { return String(value||'').split(/[,،;\s]+/).filter(x=>/^\d{1,2}\.\d{1,2}$/.test(x)); }
function publicText_(value) {
  return String(value||'').replace(/[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}/gi,'[بريد غير منشور]').replace(/\blibfile_[A-Za-z0-9_-]+\b/g,'[مرجع محفوظ]');
}

function status_(r) {
  if (r['الانطباق']==='غير منطبق معتمد' && r['مبرر الاستثناء'] && r['مرجع اعتماد الاستثناء'] && r['المراجع'] && r['تاريخ المراجعة']) return 'na';
  if (r['حالة التقييم']==='مقبول' && r['الانطباق']==='منطبق' && r['حالة الشواهد']==='مقبولة' && r['المراجع'] && r['تاريخ المراجعة']) return 'accepted';
  if (r['حالة التقييم']==='يحتاج استكمال') return 'returned';
  if (r['حالة الشواهد']==='مقدمة للمراجعة') return 'submitted';
  if (r['حالة التقييم']==='قيد التقييم') return 'in_progress';
  return 'unassessed';
}
function read_(book,name,fields,optional) {
  const sheet=book.getSheetByName(name); if(!sheet)throw new Error('SCHEMA');
  const values=sheet.getDataRange().getValues(), headers=values[0].map(String), columns=fields.map(f=>headers.indexOf(f));
  if(columns.some((n,k)=>n<0||headers.lastIndexOf(fields[k])!==n))throw new Error('SCHEMA');
  (optional||[]).forEach(f=>{fields.push(f);columns.push(headers.indexOf(f));});
  return values.slice(1).filter(v=>v.some(x=>x!=='')).map(v=>{const out={};fields.forEach((f,k)=>out[f]=v[columns[k]] instanceof Date?v[columns[k]].toISOString():String(v[columns[k]]==null?'':v[columns[k]]));return out;});
}
